    "check": "node scripts/setup.js --check",
    "preview": "node scripts/serve.js _preview"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.536",
    "@remotion/google-fonts": "4.0.536",
    "@remotion/renderer": "4.0.536",
    "heic-convert": "2.1.0",
    "libsodium-wrappers": "0.8.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.536",
    "sharp": "0.35.5"
  }

# Klucze bota iSelect. Wklej wartości po znaku = (bez spacji i cudzysłowów), zapisz plik, potem: .\setup.ps1 -Apply
# Instrukcja zdobycia każdego klucza: README.md → „Konfiguracja krok po kroku”.

# Gemini – możesz zostawić puste: skrypt weźmie klucz z projektu olx-iphone-hunter
GEMINI_API_KEY=

# Discord – token bota (Developer Portal → Bot → Reset Token)
DISCORD_BOT_TOKEN=

# Instagram – token z Meta for Developers (Instagram API → Generate token dla @iselect_hub)
IG_ACCESS_TOKEN=

# GitHub – token „classic” z uprawnieniami: repo, workflow
GITHUB_TOKEN=

# Opcjonalnie: darmowe klipy wideo do rolek ogólnych (https://www.pexels.com/api/)
PEXELS_API_KEY=

# Uzupełniane automatycznie przez setup – nie ruszaj
REVIEW_WEBHOOK_URL=
IG_USER_ID=
